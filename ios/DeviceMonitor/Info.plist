<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only the keys that have no INFOPLIST_KEY_ build setting. Everything else (display name, usage
  descriptions, orientations, UIUserInterfaceStyle, ITSAppUsesNonExemptEncryption) is generated from
  the target's build settings and merged with this file at build time.

  UIApplicationSceneManifest is written out here because the generated one always allows several
  windows on iPad. The app has one window: its router and hub session are app-wide state, and two
  windows would mirror each other's tab and present every sheet twice.
-->
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.devicemonitor.ios.refresh</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
